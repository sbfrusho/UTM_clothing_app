rules_version = '2';

// Your Shop storage rules. Profile photos live at users/{uid}/avatar.jpg:
// only the owner writes them (images under 5 MB); signed-in users can read
// (order pages in the admin app show them). Everything else is closed;
// product images are managed in the console or by the admin app via the
// Admin SDK.
service firebase.storage {
  match /b/{bucket}/o {
    match /users/{uid}/{file} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid &&
        file == 'avatar.jpg' &&
        request.resource.size < 5 * 1024 * 1024 &&
        request.resource.contentType.matches('image/.*');
      allow delete: if request.auth != null && request.auth.uid == uid;
    }
  }
}
